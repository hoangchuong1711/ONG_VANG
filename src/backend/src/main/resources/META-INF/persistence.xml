<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
    <persistence-unit name="mini-ong-vang-design-v1" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.miniongvang.entity.TaiKhoan</class>
        <class>com.miniongvang.entity.KhachHang</class>
        <class>com.miniongvang.entity.TaiXe</class>
        <class>com.miniongvang.entity.PhuongTien</class>
        <class>com.miniongvang.entity.ChinhSachThanhVien</class>
        <class>com.miniongvang.entity.BieuPhi</class>
        <class>com.miniongvang.entity.ChinhSachPhuThu</class>
        <class>com.miniongvang.entity.DonHang</class>
        <class>com.miniongvang.entity.CuocDonHang</class>
        <class>com.miniongvang.entity.PhuThuDonHang</class>
        <class>com.miniongvang.entity.KienHang</class>
        <class>com.miniongvang.entity.PhanCongDonHang</class>
        <class>com.miniongvang.entity.SuKienDonHang</class>
        <class>com.miniongvang.entity.LanThanhToan</class>
        <class>com.miniongvang.entity.XacNhanThanhToanDonHang</class>
        <class>com.miniongvang.entity.SuKienThanhToan</class>
        <class>com.miniongvang.entity.BaoGia</class>
        <class>com.miniongvang.entity.YeuCauTaoDon</class>
        <class>com.miniongvang.entity.NhatKyKiemToan</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.jdbc.time_zone" value="UTC"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>
            <property name="hibernate.use_nationalized_character_data" value="true"/>
            <property name="hibernate.type.preferred_instant_jdbc_type" value="TIMESTAMP"/>
        </properties>
    </persistence-unit>
</persistence>
