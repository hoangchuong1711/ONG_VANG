MSSQL_DATABASE=mini_ong_vang_design_v2_demo
# Set a private strong SQL Server password (upper/lowercase, digits and symbols).
MSSQL_SA_PASSWORD=
# Set a limited SQL login for application traffic when available. Migration uses sa separately.
APP_DB_USER=sa
APP_DB_PASSWORD=
# V9 SQL demo data runs only on a new designV2 demo/test database.
DESIGN_V2_DEMO=true
DESIGN_V2_RECONCILE_JOB=false
ROUTE_PROVIDER=fake
ROUTE_MAX_DISTANCE_KM=30
# Only needed when ROUTE_PROVIDER=goong (keep the key in your untracked .env).
GOONG_API_KEY=
GOONG_API_MAPTILES_KEY=
GOONG_TIMEOUT_MS=5000
GOONG_VEHICLE=car/motorcycle
# VNPay Sandbox only. Keep credentials in untracked .env.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Public HTTPS URL served by backend, e.g. https://your-tunnel.ngrok-free.dev/api/payments/vnpay/return
VNPAY_RETURN_URL=
# VNPay return displays the current driver finance page; IPN/query decides payment status.
DRIVER_RETURN_URL=http://localhost:3001/driver/wallet
# Optional server IP sent in QueryDr requests; default 127.0.0.1 for local tests.
VNPAY_QUERY_IP=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Mini Ong Vang
